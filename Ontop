end

local function farmCookingLoop()
 local firstPass = true
 while FarmCookingRunning do
 local startIdx = firstPass and 1 or FC_LOOP_START
 for idx = startIdx, #FC_ROUTE do
 if not FarmCookingRunning then break end
 local wp = FC_ROUTE[idx]
 local action = wp[2]
 if action == "circle" then
 local circ = fcFindBlueCircle(wp[1])

 local cpos = circ and circ.Position or wp[1]

 if not fcTweenToCircle(cpos) then
 fcWalkTo(cpos)
 end
 if FarmCookingRunning then

 fcStayAtCircle(cpos, FC_CIRCLE_WAIT, not circ)
 end

 if FarmCookingRunning then
 if not fcTweenTo(FC_GRAB_POS) then
 fcWalkTo(FC_GRAB_POS)
 end
 if FarmCookingRunning then
 fcPressE(FC_GRAB_POS)
 end
 end
 task.wait(0.3)
 else
 if firstPass and idx == 1 then
 pcall(function()
 local _, _, hrp0 = fcGetChar()
 if hrp0 and (wp[1] - hrp0.Position).Magnitude > 50 then
 hrp0.CFrame = CFrame.new(wp[1] + Vector3.new(0, 4, 0))
 FC_TP_GRACE_UNTIL = os.clock() + 2
 task.wait(0.5)
 end
 end)
 end
 if not fcTweenTo(wp[1]) then
 fcWalkTo(wp[1])
 end
 if action == "grab" and FarmCookingRunning then
 fcPressE(wp[1])
 end
 if action == "click" and FarmCookingRunning then
 task.wait(FC_CLICK_WAIT)
 fcClickCenter()
 end
 end
 end
 firstPass = false
 local t0 = os.clock()
 while FarmCookingRunning and os.clock() - t0 < 0.5 do
 task.wait(0.1)
 end
 end
 fcStopMovement()
end

