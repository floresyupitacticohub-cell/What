local PathfindingService = game:GetService("PathfindingService")

local function fcPathTo(pos)
 local reached = false
 pcall(function()
 local char, hum, hrp = fcGetChar()
 if not (hum and hrp) then return end
 local path = PathfindingService:CreateAsync({
 AgentRadius = 2.5,
 AgentHeight = 5,
 AgentCanJump = true,
 WaypointSpacing = 4
 })
 path:ComputeAsync(hrp.Position, pos)
 if path.Status ~= Enum.PathStatus.Success then return end
 for _, wp in ipairs(path:GetWaypoints()) do
 if not FarmCookingRunning then return end
 fcWaitPause()
 local c2, h2 = fcGetChar()
 if not c2 then return end
 if wp.Action == Enum.PathWaypointAction.Jump then
 pcall(function() h2.Jump = true end)
 end
 pcall(function() h2:MoveTo(wp.Position) end)
 local t0 = fcClock()
 while FarmCookingRunning and fcClock() - t0 < 4 do
 task.wait(0.15)
 if fcIsPaused() then fcWaitPause() end
 local _, _, p3 = fcGetChar()
 if not p3 then return end
 local flatWp = Vector3.new(wp.Position.X, p3.Position.Y, wp.Position.Z)
 if (flatWp - p3.Position).Magnitude <= 3.5 then break end
 end
 end
 local _, _, p5 = fcGetChar()
 if p5 then
 local flatEnd = Vector3.new(pos.X, p5.Position.Y, pos.Z)
 if (flatEnd - p5.Position).Magnitude <= FC.REACH + 2 then
 reached = true
 end
 end
 end)
 return reached
end

local function fcWalkTo(pos)
 local target = pos
 local attempts = 0
 while FarmCookingRunning do
 fcWaitPause()
 local char, hum, hrp = fcGetChar()
 if not char then
 fcWaitChar()
 char, hum, hrp = fcGetChar()
 if not char then return false end
 end
 local flat = Vector3.new(target.X, hrp.Position.Y, target.Z)
 if (flat - hrp.Position).Magnitude <= FC.REACH then return true end
 attempts = attempts + 1
 if attempts > 2 then return false end
 if attempts == 2 then
 if fcPathTo(target) then return true end
 return false
 end
 local timeout = math.clamp((flat - hrp.Position).Magnitude / 6 + 6, 8, 45)
 local t0 = fcClock()
 local lastPos = hrp.Position
 local stuckT = 0
 local totalStuck = 0
 pcall(function() hum:MoveTo(target) end)
 while FarmCookingRunning and fcClock() - t0 < timeout do
 task.wait(0.2)
 if fcIsPaused() then
 fcWaitPause()
 char, hum, hrp = fcGetChar()
 if not char then break end
 lastPos = hrp.Position
 else
 char, hum, hrp = fcGetChar()
 if not char then break end
 flat = Vector3.new(target.X, hrp.Position.Y, target.Z)
 if (flat - hrp.Position).Magnitude <= FC.REACH then return true end
 if (hrp.Position - lastPos).Magnitude < 0.6 then
 stuckT = stuckT + 0.2
 totalStuck = totalStuck + 0.2
 if stuckT >= 1 then pcall(function() hum.Jump = true end) stuckT = 0 end
 if totalStuck > 6 then return false end
 else
 stuckT = 0
 end
 lastPos = hrp.Position
 pcall(function() hum:MoveTo(target) end)
 end
 end
 end
 return false
end

-- Movimiento del farm con Tween (glide suave, estilo MM2) en vez de caminar
-- Si detecta un TP y el farm se pausa, cancela el tween y luego re-tweenea desde donde quedo
local function fcTweenTo(pos)
 local char, hum, hrp = fcGetChar()
 if not (char and hum and hrp) then
 fcWaitChar()
 char, hum, hrp = fcGetChar()
 if not (char and hum and hrp) then return false end
 end
 local reached = false
 local ok = pcall(function()
 while FarmCookingRunning do
 fcWaitPause()
 char, hum, hrp = fcGetChar()
 if not (char and hum and hrp) then return end
 local flatNow = Vector3.new(pos.X, hrp.Position.Y, pos.Z)
 if (flatNow - hrp.Position).Magnitude <= FC.REACH + 1 then
 reached = true
 return
 end
 local rot = hrp.CFrame - hrp.CFrame.Position
 local distancia = (Vector3.new(pos.X, pos.Y, pos.Z) - hrp.Position).Magnitude
 local duracion = math.max(distancia / math.max(FC.TWEEN_SPEED, 1), 0.1)
 local done = false
 local tween
 tween = fcTweenService:Create(
 hrp,
 TweenInfo.new(duracion, Enum.EasingStyle.Linear),
 {CFrame = CFrame.new(pos) * rot}
 )
 local conn = tween.Completed:Connect(function()
 done = true
 end)
 FC.CurrentTween = tween
 tween:Play()
 local t0 = fcClock()
 while not done and fcClock() - t0 < duracion + 1 do
 if not FarmCookingRunning or not fcGetChar() then
 pcall(function() tween:Cancel() end)
 FC.CurrentTween = nil
 conn:Disconnect()
 return
 end
 if fcIsPaused() then
 pcall(function() tween:Cancel() end)
 FC.CurrentTween = nil
 conn:Disconnect()
 break -- espera la pausa y re-tweenea desde la posicion actual
 end
 task.wait(0.05)
 end
 if not done then
 pcall(function() tween:Cancel() end)
 end
 conn:Disconnect()
 FC.CurrentTween = nil
 if FarmCookingRunning then task.wait(0.05) end
 end
 end)
 FC.CurrentTween = nil
 if not ok then return false end
 if reached then return true end
 local c2, _, p2 = fcGetChar()
 if not c2 then return false end
 local flat = Vector3.new(pos.X, p2.Position.Y, pos.Z)
 return (flat - p2.Position).Magnitude <= FC.REACH + 1
end

