 if fcTpPaused() then

  local pT0 = os.clock()
  fcWaitTpUnpaused()
  pausedAccum = pausedAccum + (os.clock() - pT0)
  if not FarmCookingRunning then break end
 end

 if forzar then
 goneT = 0
 else
 if fcFindBlueCircle(pos) then
 goneT = 0
 else
 goneT = goneT + 0.25
