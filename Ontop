-- Espera EN el circulo: iman al centro REAL del circulo (no drift), combate a los 2s, click a los 10s
local function fcStayAtCircle(pos, segundos)
 local t0 = fcClock()
 local combatDone = false
 local clickDone = false
 local center = pos
 local lastRefind = -10
 while FarmCookingRunning do
 fcWaitPause()
 local elapsed = fcClock() - t0
 if elapsed >= segundos then break end
 local char, hum, hrp = fcGetChar()
 if char then
 -- re-localiza el circulo azul real cada 1s (busca cerca del punto Y cerca de ti)
 if fcClock() - lastRefind >= 1 then
 lastRefind = fcClock()
 local c2 = fcFindBestCircle({pos, hrp.Position}, FC.CIRCLE_SEARCH)
 if c2 then
 center = Vector3.new(c2.Position.X, pos.Y, c2.Position.Z)
 end
 end
 fcSetTarget(center)
 local flatC = Vector3.new(center.X, hrp.Position.Y, center.Z)
 local d = (flatC - hrp.Position).Magnitude
 local busy = false
 pcall(function()
 busy = (isDowned() and true) or (_antiKill.enabled and _antiKill.snap.pos ~= nil and true) or false
 end)
 if not busy then
 if d > FC.CIRCLE_MAX_DRIFT then
 -- se salio del circulo: el iman lo regresa al centro
 pcall(function() hum:MoveTo(flatC) end)
 if d > FC.CIRCLE_MAX_DRIFT + 2 then
 fcTweenTo(Vector3.new(center.X, hrp.Position.Y, center.Z))
 end
 elseif d > FC.CIRCLE_LOCK_DIST then
 pcall(function() hum:MoveTo(flatC) end)
 else
 -- clavado en el centro del circulo
 pcall(function()
 hrp.CFrame = CFrame.new(flatC) * (hrp.CFrame - hrp.CFrame.Position)
 end)
 pcall(function() hum:MoveTo(flatC) end)
 end
 end
 -- a los 2s: presiona 1 (PC) y activa melee aura + auto attack + anti kill
 if not combatDone and elapsed >= FC.COMBAT_AT then
 combatDone = true
 fcEnsureCombat()
 end
 -- a los 10s: click tipo punto 6 pero mas abajo
 if not clickDone and (elapsed >= FC.CIRCLE_CLICK_AT or (segundos - elapsed) <= 0.3) then
 clickDone = true
 fcClickAt(FC.CIRCLE_CLICK_OFFSET_Y)
 end
 else
 fcWaitChar()
 end
 task.wait(0.15)
 end
 return FarmCookingRunning
end

