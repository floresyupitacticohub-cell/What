local function fcIsTrashNamed(aN)
 local s = string.lower(tostring(aN))
 for _, w in ipairs(FC_TRASH_SUB) do
 if string.find(s, w, 1, true) then
 return true
 end
 end
 for tok in string.gmatch(s, "%a+") do
 for _, w in ipairs(FC_TRASH_WORD) do
 if tok == w then
 return true
 end
 end
 end
 return false
end

local function fcIsTrashObject(part)
 if fcIsTrashNamed(part.Name) then
 return true
 end
 local anc = part.Parent
