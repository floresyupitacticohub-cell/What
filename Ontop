        end)
        if okCar and car then
            return car
        end
        local char = r.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if seat then
            return seat:FindFirstAncestorOfClass("Model")
        end
        return nil
    end

    local function getAllCharacterTargets()
        local list = {}
        local okAll, allChars = pcall(function()
            return o.get_all and o.get_all()
        end)
        if okAll and type(allChars) == "table" then
            for _, ch in pairs(allChars) do
                if typeof(ch) == "Instance" and ch:IsA("Model") then
                    table.insert(list, ch)
                end
            end
            return list
        end
        for _, pl in ipairs(a:GetPlayers()) do
            if pl ~= r and pl.Character then
                table.insert(list, pl.Character)
            end
        end
        return list
    end

    local function bumpAuraLoop(gen)
        task.spawn(function()
            while bumpAuraEnabled and gen == bumpAuraGeneration do
                task.wait(0.15)
                pcall(function()
                    local myChar = r.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if not myRoot then return end
                    local car = getCarPlayerIsIn()
                    if not car then return end
                    local driverSeat = car:FindFirstChild("DriverSeat", true)
                    if not driverSeat or not driverSeat:IsA("BasePart") then return end
                    for _, target in ipairs(getAllCharacterTargets()) do
                        if not bumpAuraEnabled or gen ~= bumpAuraGeneration then break end
                        if target and target ~= myChar then
                            local hrp = target:FindFirstChild("HumanoidRootPart")
                            if hrp and (hrp.Position - myRoot.Position).Magnitude < bumpAuraDistance then
                                local assembly = driverSeat.AssemblyLinearVelocity + Vector3.new(115, 115, 115)
                                if E then
                                    CallRemote(E, "run_over", car, target, assembly)
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end

    -- ---- Invisible en asiento (pose del personaje en el carro) ----
    local seatPose = {
        enabled = false,
        angle = -101,
        motor = nil,
        originalC0 = nil,
        neck = nil,
        neckC0 = nil,
        applied = false,
    }

    local function isVehicleSeat(seat)
        if not seat then return false end
        if seat:IsA("VehicleSeat") then return true end
        local vf = workspace:FindFirstChild("Vehicles")
        if vf and seat:IsDescendantOf(vf) then
            return true
        end
        local model = seat:FindFirstAncestorOfClass("Model")
        if model and (
            model:FindFirstChildOfClass("VehicleSeat")
            or model:FindFirstChild("DriverSeat", true)
            or model:FindFirstChild("DriveSeat", true)
            or model:GetAttribute("IsVehicle")
        ) then
            return true
        end
        return false
    end

    local function findRootMotor(char)
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("Motor6D") and (obj.Part0 == hrp or obj.Part1 == hrp) then
                return obj
            end
        end
        return nil
    end

    local function restoreSeatPose()
        local motor = seatPose.motor
        local originalC0 = seatPose.originalC0
        if motor and motor.Parent and originalC0 then
            pcall(function() motor.C0 = originalC0 end)
        end
        if seatPose.neck and seatPose.neck.Parent and seatPose.neckC0 then
            pcall(function() seatPose.neck.C0 = seatPose.neckC0 end)
        end
        seatPose.neck = nil
        seatPose.neckC0 = nil
        seatPose.motor = nil
        seatPose.originalC0 = nil
        seatPose.applied = false
    end

    local function applySeatPose()
        local char = r.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if not seatPose.enabled or not seat or not isVehicleSeat(seat) then
            restoreSeatPose()
            return
        end
        local motor = findRootMotor(char)
        if not motor then
            restoreSeatPose()
            return
        end
        if seatPose.motor ~= motor then
            restoreSeatPose()
            seatPose.motor = motor
            seatPose.originalC0 = motor.C0
            local head = char:FindFirstChild("Head")
            for _, joint in ipairs(char:GetDescendants()) do
                if joint:IsA("Motor6D") and (joint.Name == "Neck" or (head and joint.Part1 == head)) then
                    seatPose.neck = joint
                    seatPose.neckC0 = joint.C0
                    break
                end
            end
        end
        local base = seatPose.originalC0
        if not base then return end
        local angle = math.clamp(tonumber(seatPose.angle) or -101, -120, 120)
        local scaled = -angle / 101
        local amount = math.clamp(math.abs(angle) / 101, 0, 1)
        local rotationBack = math.rad(180 * amount)
        local sideTwist = math.rad(17 * amount)
        pcall(function()
            motor.C0 = base
                * CFrame.new(0, -0.24 * amount, -1.38 * scaled)
                * CFrame.Angles(math.rad(angle), 0, 0)
                * CFrame.Angles(0, rotationBack, sideTwist)
            if seatPose.neck and seatPose.neck.Parent and seatPose.neckC0 then
                seatPose.neck.C0 = seatPose.neckC0
                    * CFrame.new(0, -0.28 * amount, -0.34 * scaled)
                    * CFrame.Angles(math.rad(-42 * scaled), math.rad(12 * amount), -sideTwist)
            end
        end)
        seatPose.applied = true
    end

    local seatPoseGen = 0
    local seatPoseSeatConn = nil

    local function bindSeatPoseCharacter(char)
        seatPoseGen = seatPoseGen + 1
        local gen = seatPoseGen
        if seatPoseSeatConn then
            seatPoseSeatConn:Disconnect()
            seatPoseSeatConn = nil
        end
        restoreSeatPose()
        if not char then return end
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 12)
            if not hum or gen ~= seatPoseGen then return end
            seatPoseSeatConn = hum.Seated:Connect(function()
                task.defer(function()
                    if gen == seatPoseGen then
                        applySeatPose()
                    end
                end)
            end)
            for _ = 1, 12 do
                if gen ~= seatPoseGen then return end
                applySeatPose()
                task.wait(0.15)
            end
        end)
    end

    local seatPoseAcc = 0
    b.Heartbeat:Connect(function(dt)
        seatPoseAcc = seatPoseAcc + (dt or 0)
        if seatPoseAcc < 0.05 then return end
        seatPoseAcc = 0
        pcall(applySeatPose)
    end)
    r.CharacterAdded:Connect(function(char)
        bindSeatPoseCharacter(char)
    end)
    r.CharacterRemoving:Connect(function()
        seatPoseGen = seatPoseGen + 1
        if seatPoseSeatConn then
            seatPoseSeatConn:Disconnect()
            seatPoseSeatConn = nil
        end
        restoreSeatPose()
    end)
    bindSeatPoseCharacter(r.Character)

    -- ---- Velocidad del vehiculo (VehicleSeat) ----
    local vehSpeed = {
        enabled = false,
        maxSpeed = 150,
        torque = 8000,
        turnSpeed = 30,
        seat = nil,
        originals = nil,
    }

    local function getVehicleSeat()
