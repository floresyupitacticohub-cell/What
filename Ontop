local espAccumulator = 0

RunService.Heartbeat:Connect(function(delta)
    espAccumulator = espAccumulator + delta
    if espAccumulator < 0.15 then
        return
    end
    espAccumulator = 0
    if not State.ESPEnabled then
        clearAllESP()
        return
    end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not root or not humanoid or humanoid.Health <= 0 then
                clearESP(plr)
            else
                createESP(plr)
                local data = ESPObjects[plr]
                if data then
                    local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
                    if dist <= State.ESPMaxDistance then
                        if data.Highlight.Parent ~= char then
                            data.Highlight.Parent = char
                        end
                        if data.Billboard.Parent ~= root then
                            data.Billboard.Parent = root
                        end
                        local friendPlayer = isFriend(plr)
                        data.Highlight.Enabled = State.ESPBoxes
                        data.Highlight.FillColor = friendPlayer and Color3.fromRGB(60, 255, 110) or State.ESPColor
                        data.Billboard.Enabled = State.ESPNames or State.ESPDistance
                        local parts = {}
                        if State.ESPNames then
                            table.insert(parts, plr.DisplayName)
                        end
                        if State.ESPDistance then
                            table.insert(parts, tostring(math.floor(dist)) .. " studs")
                        end
                        data.Label.Text = table.concat(parts, " | ")
                        data.Label.TextColor3 = friendPlayer and Color3.fromRGB(60, 255, 110) or Color3.fromRGB(255, 255, 255)
                    else
                        data.Highlight.Enabled = false
                        data.Billboard.Enabled = false
                    end
                end
            end
        end
    end
end)

RunService:BindToRenderStep("SK_Combat", Enum.RenderPriority.Camera.Value + 1, function()
    State.CombatTarget = nil
    if State.AutoShoot or State.SilentAim then
        State.CombatTarget = getTarget()
    end
    if State.AutoShoot then
        local target = State.CombatTarget
        if target then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            if State.CanClick and not State.Shooting then
                mouse1press()
                State.Shooting = true
            end
        elseif State.Shooting then
            if State.CanClick then
                mouse1release()
            end
            State.Shooting = false
        end
    elseif State.Shooting then
        if State.CanClick then
            mouse1release()
        end
        State.Shooting = false
    end
end)

if hookmetamethod and newcclosure then
    local Mouse = LocalPlayer:GetMouse()
    local OldIndex
    OldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        local result = OldIndex(self, key)
        if State.SilentAim and self == Mouse then
            local target = State.CombatTarget
            if target and target.Parent then
                if key == "Hit" then
                    return CFrame.new(target.Position)
                end
                if key == "Target" then
                    return target
                end
            end
        end
        return result
    end))
end

RunService.Heartbeat:Connect(function()
    if not State.BumpCar then
        return
    end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isFriend(plr) then
            local char = plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local offset = root.Position - myRoot.Position
                local dist = offset.Magnitude
                if dist <= State.BumpDistance then
                    local dir = dist > 0.1 and offset.Unit or Vector3.new(0, 1, 0)
                    root.AssemblyLinearVelocity = dir * State.BumpForce + Vector3.new(0, State.BumpForce * 0.5, 0)
                end
            end
        end
    end
end)

