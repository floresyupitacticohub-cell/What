do
 local function isDoor(bx)
 if not bx or not bx:IsA("BasePart") then return false end
 local by = string.lower(bx.Name)
 if by == "door" or by == "doors" or by == "gate" then return true end
 if string.find(by, "door") then return true end
 if string.match(by, "^door[lr][fr]$") then return true end
 if string.match(by, "^door[flr]+$") then return true end
 if by == "trunk" or by == "hood" or by == "hooddoor" or by == "trunkdoor" then return true end
 return false
 end

 local function isWindow(bx)
 if not bx or not bx:IsA("BasePart") then return false end
 local by = string.lower(bx.Name)
 if by == "window" or by == "windows" or by == "windshield" or by == "windscreen" then return true end
 if by == "rearwindow" or by == "backwindow" or by == "frontwindow" then return true end
 if string.match(by, "^window[lr]f?$") then return true end
 if string.match(by, "^window[lr]b$") then return true end
 if string.match(by, "^windshieldl$") or string.match(by, "^windshieldr$") then return true end
 if string.match(by, "^window_front$") or string.match(by, "^window_rear$") then return true end
 if string.match(by, "^window_left$") or string.match(by, "^window_right$") then return true end
 if by == "glass" or by == "windowpane" or by == "glasspane" then return true end
 if string.find(by, "window") then return true end
 if string.find(by, "windshield") then return true end
 if string.find(by, "windscreen") then return true end
 return false
 end

 local function removePart(bx)
 pcall(function()
 bx.CanCollide = false
 bx.Transparency = 1
 bx.CanQuery = false
 bx:Destroy()
 end)
 return true
 end

 local function removeAllDoors()
 local removed = 0
 for _, by in ipairs(g:GetDescendants()) do
 if isDoor(by) then
 if removePart(by) then removed = removed + 1 end
 end
 end
 return removed
 end

 local function removeAllWindows()
 local removed = 0
 for _, by in ipairs(g:GetDescendants()) do
 if isWindow(by) then
 if removePart(by) then removed = removed + 1 end
 end
 end
 return removed
 end

 task.spawn(function()
 task.wait(2)
 local dr = removeAllDoors()
 local wr = removeAllWindows()
 g.DescendantAdded:Connect(function(by)
 if isDoor(by) or isWindow(by) then
