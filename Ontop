        if seat and seat:IsA("VehicleSeat") then
            return seat
        end
        return nil
    end

    local function restoreVehSeat()
        local seat = vehSpeed.seat
        local orig = vehSpeed.originals
        if seat and seat.Parent and orig then
            pcall(function()
                seat.MaxSpeed = orig.MaxSpeed
                seat.Torque = orig.Torque
                seat.TurnSpeed = orig.TurnSpeed
            end)
        end
        vehSpeed.seat = nil
        vehSpeed.originals = nil
    end

    local function applyVehSeat()
        if not vehSpeed.enabled then
            if vehSpeed.seat then
                restoreVehSeat()
            end
            return
        end
        local seat = getVehicleSeat()
        if not seat then
            if vehSpeed.seat then
                restoreVehSeat()
            end
            return
        end
        if vehSpeed.seat ~= seat then
            restoreVehSeat()
            vehSpeed.seat = seat
            vehSpeed.originals = {
                MaxSpeed = seat.MaxSpeed,
                Torque = seat.Torque,
                TurnSpeed = seat.TurnSpeed,
            }
        end
        pcall(function()
            seat.MaxSpeed = vehSpeed.maxSpeed
            seat.Torque = vehSpeed.torque
            seat.TurnSpeed = vehSpeed.turnSpeed
        end)
    end

