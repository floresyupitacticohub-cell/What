local function QK_cancelarTween()
 pcall(function()
 if QK_TWEEN_ACTUAL then
 QK_TWEEN_ACTUAL:Cancel()
 QK_TWEEN_ACTUAL = nil
 end
 end)
end

local function QK_moverHacia(cf)
 local hrp = QK_obtenerHRP()
 if not hrp then return false end
 local distancia = (cf.Position - hrp.Position).Magnitude
 if distancia < 0.5 then return true end
 local duracion = math.max(distancia / math.max(_G.MM2.rutaSpeed, 1), 0.1)
 local tween = QK_TWEEN_SERVICE:Create(hrp, TweenInfo.new(duracion, Enum.EasingStyle.Linear), { CFrame = cf })
 QK_TWEEN_ACTUAL = tween
 tween:Play()
 local resultado = tween.Completed:Wait()
 QK_TWEEN_ACTUAL = nil
 return resultado == Enum.PlaybackState.Completed
end

local function QK_irAPuntoPos(pos)
 local hrp = QK_obtenerHRP()
 if not hrp then return false end
 return QK_moverHacia(CFrame.new(pos) * hrp.CFrame.Rotation)
end

local function QK_esCirculoAzul(obj)
 if not obj:IsA("BasePart") then return false end
 if obj.Transparency >= 0.9 then return false end
 local c = obj.Color
 local porColor = c.B >= 0.4 and c.B > c.R * 1.35 and c.B >= c.G * 1.05
 local nombre = string.lower(obj.Name)
 local porNombre = string.find(nombre, "circle", 1, true)
 or string.find(nombre, "circul", 1, true)
 or string.find(nombre, "blue", 1, true)
 or string.find(nombre, "azul", 1, true)
 return porColor or (porNombre and c.B > c.R)
end

local function QK_buscarCirculoAzul(referencia)
 local mejor, distMejor
 pcall(function()
 local partes = workspace:GetPartBoundsInRadius(referencia, QK_RADIO_CIRCULO)
 for _, obj in ipairs(partes) do
 if QK_esCirculoAzul(obj) then
 local mdl = obj:FindFirstAncestorOfClass("Model")
 local esChar = mdl and a:GetPlayerFromCharacter(mdl)
 if not esChar and not fcIsTrashObject(obj) then
 local d = (obj.Position - referencia).Magnitude
 if d <= QK_RADIO_CIRCULO and (not distMejor or d < distMejor) then
 mejor, distMejor = obj, d
 end
 end
 end
 end
 end)
 return mejor
end

