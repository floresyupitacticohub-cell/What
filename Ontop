-- FILTRO DE BASURA: ignora botes de basura, cubos, barriles, tachos y props azules que NO son el circulo
FC.TRASH_SUB = {"trash", "basura", "garbage", "dumpster", "waste", "recycl", "tacho"}
FC.TRASH_WORD = {"bin", "can", "bote", "cubo", "dump"}

local function fcIsTrashNamed(aN)
 local s = string.lower(tostring(aN))
 for _, w in ipairs(FC.TRASH_SUB) do
 if string.find(s, w, 1, true) then
 return true
 end
 end
 for tok in string.gmatch(s, "%a+") do
 for _, w in ipairs(FC.TRASH_WORD) do
 if tok == w then
 return true
 end
 end
 end
 return false
end

local function fcIsTrashObject(part)
 if fcIsTrashNamed(part.Name) then
 return true
 end
 local anc = part.Parent
 local depth = 0
 while anc and anc ~= workspace and depth < 4 do
 if fcIsTrashNamed(anc.Name) then
 return true
 end
 anc = anc.Parent
 depth = depth + 1
 end
 return false
end

local function fcFindBlueCircleInRadius(pos, radius)
 local ok, parts = pcall(function()
 return workspace:GetPartBoundsInRadius(pos, radius)
 end)
 if ok and parts then
 local best, bestScore
 for _, part in ipairs(parts) do
 if part:IsA("BasePart") and part.Transparency < 0.95 then
 local mdl = part:FindFirstAncestorOfClass("Model")
 local isChar = mdl and a:GetPlayerFromCharacter(mdl)
 if not isChar and not fcIsTrashObject(part) then
 local sX, sY, sZ = part.Size.X, part.Size.Y, part.Size.Z
 local footprint = math.max(sX, sZ)
 local isStanding = sY > footprint * 1.15 and sY > 1.8
 if not isStanding then
 local flatD = (Vector3.new(part.Position.X, pos.Y, part.Position.Z) - pos).Magnitude
 if flatD <= radius then
 local blue = false
 if fcBlueDominant(part.Color) then
 blue = true
 end
 if not blue then
 for _, ch in ipairs(part:GetChildren()) do
 if (ch:IsA("Decal") or ch:IsA("Texture")) and fcBlueDominant(ch.Color) then
 blue = true
 break
 end
 end
 end
 if not blue then
 for _, ch in ipairs(part:GetChildren()) do
 if ch:IsA("BillboardGui") or ch:IsA("SurfaceGui") then
 if fcGuiHasBlue(ch) then
 blue = true
 break
 end
 end
 end
 end
 if blue then
 local d = (part.Position - pos).Magnitude
 local flatBonus = math.max(0, 3 - sY) * 2
 local nameBonus = 0
 local nmScan = string.lower(tostring(part.Name)) .. " " .. string.lower(tostring(mdl and mdl.Name or ""))
 if nmScan:find("cook", 1, true) or nmScan:find("pot", 1, true) or nmScan:find("circle", 1, true)
 or nmScan:find("food", 1, true) or nmScan:find("soup", 1, true) or nmScan:find("stove", 1, true) then
 nameBonus = 15
 end
 if nmScan:find("car", 1, true) or nmScan:find("vehicle", 1, true) or nmScan:find("truck", 1, true)
 or nmScan:find("bike", 1, true) or nmScan:find("wheel", 1, true) then
 nameBonus = nameBonus - 20
 end
 local score = -d + flatBonus + nameBonus
 if not bestScore or score > bestScore then
 best, bestScore = part, score
 end
 end
 end
 end
 end
 end
 end
 return best
 end
 return nil
end

local function fcFindBlueCircle(pos)
 -- primero el radio normal; si no encuentra, amplia la busqueda (el circulo puede estar un poco off del punto de ruta)
 return fcFindBlueCircleInRadius(pos, FC.BLUE_RADIUS) or fcFindBlueCircleInRadius(pos, 25)
end

-- RUTA OPTIMIZADA: busca el mejor circulo azul REAL entre varios centros
-- (el punto de ruta y tu posicion actual) y devuelve el mas cercano a ti
local function fcFindBestCircle(centers, radius)
 local best, bestD
 local _, _, hrpB = fcGetChar()
 for _, cpos in ipairs(centers) do
 if cpos then
 local part = fcFindBlueCircleInRadius(cpos, radius)
 if part then
 local ref = hrpB or cpos
 local d = (part.Position - ref).Magnitude
 if not bestD or d < bestD then
 best, bestD = part, d
 end
 end
 end
 end
 return best
end

local function fcIsBlueCircleNear(pos)
 return fcFindBlueCircle(pos) ~= nil
end

local function fcFindPrompt(pos, radius)
 local best, bestD
 for _, obj in ipairs(workspace:GetDescendants()) do
 if obj:IsA("ProximityPrompt") and obj.Enabled then
 local anchor = obj.Parent
 if anchor and anchor:IsA("Attachment") and anchor.Parent then anchor = anchor.Parent end
 local ppos
 if anchor and anchor:IsA("BasePart") then
 ppos = anchor.Position
 elseif anchor and anchor:IsA("Model") then
 local pp = anchor.PrimaryPart or anchor:FindFirstChildWhichIsA("BasePart")
 if pp then ppos = pp.Position end
 end
 if ppos then
 local d = (ppos - pos).Magnitude
 if d <= radius and (not bestD or d < bestD) then
 best, bestD = obj, d
 end
 end
 end
 end
 return best
end

