local function notify(text, duration)
    if State.Notify then
        Library:Notify(text, duration or 3)
    end
end

local function getPlayerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(names, plr.Name)
        end
    end
    table.sort(names)
    return names
end

local function normalizeSelection(value)
    local set = {}
    if type(value) == "table" then
        for key, val in pairs(value) do
            if val == true then
                set[key] = true
            elseif type(val) == "string" and val ~= "" then
                set[val] = true
            end
        end
    end
    return set
end

local function isFriend(plr)
    return State.Friends[plr.Name] == true
end

local function getCharacter(plr)
    local char = plr.Character
    if not char or not char.Parent then
        return nil
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 0 then
        return char
    end
    return nil
end

local function getAimPart(char)
    return char:FindFirstChild(State.AimPart) or char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
end

local function isVisible(char, aimPart)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar.PrimaryPart or not aimPart then
        return false
    end
    local origin = myChar.PrimaryPart.Position
    local direction = aimPart.Position - origin
    if direction.Magnitude <= 0.1 then
        return true
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar, char, Camera }
    local result = Workspace:Raycast(origin, direction, params)
    return result == nil
end

local function getTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar.PrimaryPart then
        return nil
    end
    local origin = myChar.PrimaryPart.Position
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isFriend(plr) then
            local char = getCharacter(plr)
            if char then
                local aimPart = getAimPart(char)
                if aimPart then
                    local dist = (aimPart.Position - origin).Magnitude
                    if dist <= State.TargetRange and dist < bestDist then
                        if (not State.VisibleCheck) or isVisible(char, aimPart) then
                            best = aimPart
                            bestDist = dist
                        end
                    end
                end
            end
        end
    end
    return best
end

local function buyItem(keywords, label)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar.PrimaryPart then
        notify("Personaje no disponible")
        return
    end
    local origin = myChar.PrimaryPart.Position
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local text = nil
        if obj:IsA("ProximityPrompt") then
            text = obj.Name .. " " .. tostring(obj.ActionText) .. " " .. tostring(obj.ObjectText)
        elseif obj:IsA("ClickDetector") then
            text = obj.Name .. " " .. (obj.Parent and obj.Parent.Name or "")
        end
        if text then
            text = string.lower(text)
            local found = false
            for _, keyword in ipairs(keywords) do
                if string.find(text, string.lower(keyword), 1, true) then
                    found = true
                    break
                end
            end
            if found then
                local part = nil
                if obj:IsA("ProximityPrompt") then
                    if obj.Parent then
                        if obj.Parent:IsA("BasePart") then
                            part = obj.Parent
                        else
                            part = obj.Parent:FindFirstChildWhichIsA("BasePart", true)
                        end
                    end
                elseif obj.Parent and obj.Parent:IsA("BasePart") then
                    part = obj.Parent
                end
                if part then
                    local dist = (part.Position - origin).Magnitude
                    if dist < bestDist then
                        best = obj
                        bestDist = dist
                    end
                end
            end
        end
    end
    if best then
        if best:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(best)
            end
        elseif fireclickdetector then
            fireclickdetector(best)
        end
        notify(label .. " listo")
    else
        notify(label .. ": tienda no encontrada")
    end
end

local function applyJumpPower()
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = State.JumpPower
    end
end

local ESPObjects = {}

local function clearESP(plr)
    local data = ESPObjects[plr]
    if data then
        if data.Highlight then
            data.Highlight:Destroy()
        end
        if data.Billboard then
            data.Billboard:Destroy()
        end
        ESPObjects[plr] = nil
    end
end

local function clearAllESP()
    for plr in pairs(ESPObjects) do
        clearESP(plr)
    end
end

local function createESP(plr)
    if ESPObjects[plr] then
        return
    end
    local highlight = Instance.new("Highlight")
    highlight.Name = "SK_ESP_Box"
    highlight.FillColor = State.ESPColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SK_ESP_Info"
    billboard.Size = UDim2.new(0, 160, 0, 24)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.25
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.Text = ""
    label.Parent = billboard

    ESPObjects[plr] = { Highlight = highlight, Billboard = billboard, Label = label }
end

