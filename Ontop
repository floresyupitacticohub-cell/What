do
    local moneyNormalizeKey = function(value)
        return tostring(value or ""):lower():gsub("[^%w]", "")
    end

    local moneyParse = function(value)
        if type(value) == "number" then
            return math.floor(value + 0.5)
        end
        local str = tostring(value or ""):gsub(",", ""):gsub("%s+", "")
        local numberText, suffix = str:match("([%-]?%d+%.?%d*)([kKmMbB]?)")
        local number = tonumber(numberText)
        if not number then return nil end
        suffix = tostring(suffix or ""):lower()
        if suffix == "k" then
            number = number * 1000
        elseif suffix == "m" then
            number = number * 1000000
        elseif suffix == "b" then
            number = number * 1000000000
        end
        return math.floor(number + 0.5)
    end

    local moneyFormat = function(value)
        if value == nil then return "..." end
        local str = tostring(math.floor(tonumber(value) or 0))
        while true do
            local changed
            str, changed = str:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
            if changed == 0 then break end
        end
        return "$" .. str
    end

    local moneyReadNamedData = function(mode)
        local roots = { r }
        if r.Character then
            table.insert(roots, r.Character)
        end

        local function keyMatches(key)
            if mode == "bank" then
                return key == "bankbalance"
                    or key == "bankmoney"
                    or key == "bankcash"
                    or key == "atmbalance"
                    or key == "atmmoney"
                    or key == "bankamount"
                    or key == "bankfunds"
                    or key == "balancebank"
            else
                return key == "money"
                    or key == "cash"
                    or key == "wallet"
                    or key == "carriedmoney"
                    or key == "handbalance"
            end
        end

        for _, root in ipairs(roots) do
            for attrName, attrValue in pairs(root:GetAttributes()) do
                local key = moneyNormalizeKey(attrName)
                if keyMatches(key) then
                    local parsed = moneyParse(attrValue)
                    if parsed ~= nil then return parsed end
                end
            end
        end

        for _, obj in ipairs(r:GetDescendants()) do
            if obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("StringValue") then
                local key = moneyNormalizeKey(obj.Name)
                if keyMatches(key) then
                    local parsed = moneyParse(obj.Value)
                    if parsed ~= nil then return parsed end
                end
            end
        end

        return nil
    end

    local moneyReadHUD = function(playerGui)
        local topRight = playerGui:FindFirstChild("TopRightHud")
        local holder = topRight and topRight:FindFirstChild("Holder")
        local frame = holder and holder:FindFirstChild("Frame")
        local moneyLabel = frame and frame:FindFirstChild("MoneyTextLabel")

        if moneyLabel and moneyLabel:IsA("TextLabel") then
            local value = moneyParse(moneyLabel.Text)
            if value ~= nil then return value end
        end

        if topRight then
            for _, obj in ipairs(topRight:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local clue = moneyNormalizeKey(obj.Name .. " " .. tostring(obj.Text or ""))
                    if (clue:find("money", 1, true)
                            or clue:find("cash", 1, true)
                            or clue:find("wallet", 1, true))
                        and not clue:find("bank", 1, true)
                        and not clue:find("atm", 1, true) then
                        local value = moneyParse(obj.Text)
                        if value ~= nil then return value end
                    end
                end
            end
        end

        return nil
    end

    local moneyReadBankGUI = function(playerGui)
        local function scanRoot(root)
            if not root then return nil end
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local textValue = tostring(obj.Text or "")
                    local nameValue = tostring(obj.Name or "")
                    local clue = moneyNormalizeKey(nameValue .. " " .. textValue)

                    if clue:find("bankbalance", 1, true)
                        or clue:find("atmbalance", 1, true)
                        or clue:find("bankmoney", 1, true)
                        or clue:find("bankfunds", 1, true) then

                        local value = moneyParse(textValue)
                        if value ~= nil then return value end

                        local parent = obj.Parent
                        if parent then
                            for _, sibling in ipairs(parent:GetDescendants()) do
                                if sibling ~= obj and (sibling:IsA("TextLabel") or sibling:IsA("TextButton") or sibling:IsA("TextBox")) then
                                    local siblingText = tostring(sibling.Text or "")
                                    if siblingText:find("$", 1, true) or siblingText:match("[%d,]+") then
                                        value = moneyParse(siblingText)
                                        if value ~= nil then return value end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            return nil
        end

        local value = scanRoot(playerGui)
        if value ~= nil then return value end

        pcall(function()
            value = scanRoot(game:GetService("CoreGui"))
        end)
        if value ~= nil then return value end

        if gethui then
            local okHui, hui = pcall(gethui)
            if okHui and hui then
                value = scanRoot(hui)
                if value ~= nil then return value end
            end
        end

        return nil
    end

    local moneyReadBankTables = function()
        if not getgc then return nil end
        local strongKeys = {
            bankbalance = true,
            bankmoney = true,
            bankcash = true,
            atmbalance = true,
            atmmoney = true,
            bankamount = true,
            bankfunds = true,
            balancebank = true
        }
        local okGC, objects = pcall(function()
            return getgc(true)
        end)
        if not okGC or type(objects) ~= "table" then return nil end
        for _, item in ipairs(objects) do
            if typeof(item) == "table" then
                local okTable, result = pcall(function()
                    for key, value in pairs(item) do
                        if strongKeys[moneyNormalizeKey(key)] then
                            local parsed = moneyParse(value)
                            if parsed ~= nil then
                                return parsed
                            end
                        end
                    end
                end)
                if okTable and result ~= nil then
                    return result
                end
            end
        end
        return nil
    end

    local moneyLastCarried = nil
    local moneyLastBank = nil

    pcall(function()
        farmGroupbox:AddDivider()
    end)

    local function makeFarmMoneyLabel(text)
        local setter = function(v) end
        local done = false
        pcall(function()
            local lbl = farmGroupbox:AddLabel({ Text = text })
            if lbl and lbl.SetText then
                setter = function(v)
                    pcall(function() lbl:SetText(tostring(v)) end)
                end
                done = true
            end
        end)
        if not done then
            pcall(function()
                local lbl = farmGroupbox:AddLabel(text)
                if lbl and lbl.SetText then
                    setter = function(v)
                        pcall(function() lbl:SetText(tostring(v)) end)
                    end
                    done = true
                end
            end)
        end
        if not done then
            pcall(function()
                local idx = "yup_money_lbl_" .. tostring(math.random(100000, 999999))
                local inp = farmGroupbox:AddInput(idx, {
                    Text = text,
                    Default = "...",
                    Placeholder = "",
                    Callback = function() end,
                })
                if inp then
                    setter = function(v)
                        pcall(function()
                            if inp.SetValue then inp:SetValue(tostring(v)) end
                        end)
                    end
                end
            end)
        end
        return setter
    end

    local moneySetMoney = makeFarmMoneyLabel("Money: ...")
    local moneySetBank = makeFarmMoneyLabel("Bank: ...")

    task.spawn(function()
        while true do
            task.wait(0.5)
            pcall(function()
                local playerGui = r:FindFirstChild("PlayerGui")
                if not playerGui then return end

                local carriedMoney = moneyReadHUD(playerGui) or moneyReadNamedData("money")
                local bankMoney = moneyReadBankGUI(playerGui) or moneyReadNamedData("bank") or moneyReadBankTables()

                if carriedMoney ~= nil then
                    moneyLastCarried = carriedMoney
                end
                if bankMoney ~= nil then
                    moneyLastBank = bankMoney
                end

                moneySetMoney("Money: " .. moneyFormat(moneyLastCarried))
                moneySetBank("Bank: " .. moneyFormat(moneyLastBank))
            end)
        end
    end)
end

